---
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
import "../styles/extra.css";
import "../styles/layout.css";
import "../styles/home.css";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { site } from "../data/site";
import { ui, routes, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  alt?: string; // adresse de la même page dans l’autre langue
  title?: string;
  description?: string;
  type?: "website" | "article";
}
const { lang = "fr", alt = routes.en.home, title, description, type = "website" } = Astro.props;
const t = ui[lang];
const fallbackDescription =
  lang === "fr"
    ? site.description
    : "Cybersecurity engineering student at TEK-UP (Tunis). DevSecOps, Kubernetes and detection: projects, architectures and lessons learned.";
const metaDescription = description ?? fallbackDescription;
const siteTitle = lang === "fr" ? site.title : "Ramzi Ben Romdhane, cybersecurity and DevSecOps engineer";
const fullTitle = title ? `${title} | ${site.name}` : siteTitle;
// Titre court pour les aperçus LinkedIn : au-delà de ~45 caractères, la carte le tronque.
const ogTitle = title ?? "Ramzi Ben Romdhane | DevSecOps et SOC";
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const frHref = lang === "fr" ? path : alt;
const enHref = lang === "en" ? path : alt;
const sameAs = [site.github, site.linkedin].filter(Boolean);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  email: site.email,
  jobTitle: t.jobTitle,
  alumniOf: "TEK-UP University",
  ...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a1222" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={new URL(frHref, site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, site.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(frHref, site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:image" content={new URL("/og.png", site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/theme.js"></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#contenu">{t.skip}</a>
    <SiteHeader lang={lang} frHref={frHref} enHref={enHref} path={path} />
    <main id="contenu">
      <slot />
    </main>
    <footer class="container site-footer">
      <p>© {new Date().getFullYear()} {site.name}. {t.footer}</p>
      <p><a href={routes[lang].project("ce-site")}>{t.howBuilt}</a></p>
    </footer>
    <script is:inline src="/menu.js"></script>
  </body>
</html>
