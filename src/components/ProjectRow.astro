---
import type { CollectionEntry } from "astro:content";
interface Props { project: CollectionEntry<"projects"> }
const { project } = Astro.props;
const { title, summary, year, status, tags } = project.data;
---

<li>
  <a class="row-link" href={`/projets/${project.id}`}>
    <span class="row-year">{year}</span>
    <span class="row-main">
      <span class="row-title">{title}</span>
      <span class="row-summary">{summary}</span>
      <span class="row-tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>
    </span>
    <span class="row-status">{status}</span>
  </a>
</li>
