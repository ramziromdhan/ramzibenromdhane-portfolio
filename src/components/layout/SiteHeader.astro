---
import Icon from "../ui/Icon.astro";
import { site } from "../../data/site";
import { ui, routes, type Lang } from "../../i18n/ui";

interface Props { lang: Lang; frHref: string; enHref: string; path: string }
const { lang, frHref, enHref, path } = Astro.props;
const t = ui[lang];
const home = routes[lang].home;
const links = [
  { href: routes[lang].projects, label: t.nav.projects, current: path.startsWith(routes[lang].projects) },
  { href: `${home}#competences`, label: t.nav.skills, current: false },
  { href: `${home}#parcours`, label: t.nav.background, current: false },
  { href: `${home}#contact`, label: t.nav.contact, current: false },
];
const [firstName] = site.name.split(" ");
---

<header class="site-header">
  <div class="header-pill">
    <a class="brand" href={home}>
      <span class="brand-mark"><Icon name="terminal" size={16} /></span>
      <span class="brand-full">{site.name}</span>
      <span class="brand-short">{firstName}</span>
    </a>
    <nav id="site-nav" class="site-nav" aria-label={t.mainNav}>
      {links.map((l) => <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>)}
    </nav>
    <div class="header-tools">
      <div class="lang" role="group" aria-label={t.langLabel}>
        <a href={frHref} hreflang="fr" lang="fr" aria-current={lang === "fr" ? "true" : undefined}>FR</a>
        <a href={enHref} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
      </div>
      <button id="theme-toggle" class="icon-btn" type="button" aria-label={t.theme}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
        </svg>
      </button>
      <button id="menu-toggle" class="icon-btn menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" aria-label={t.menu}>
        <Icon name="menu" class="icon-open" />
        <Icon name="x" class="icon-close" />
      </button>
    </div>
  </div>
</header>
