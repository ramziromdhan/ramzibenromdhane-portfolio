---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import ProjectRow from "./ProjectRow.astro";
import Hero from "./home/Hero.astro";
import TechBar from "./home/TechBar.astro";
import { homeExtras } from "../data/home";
import { content } from "../i18n/content";
import { getProjects } from "../i18n/projects";
import { ui, routes, type Lang } from "../i18n/ui";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const extras = homeExtras[lang];
const c = content(lang);
const featured = await getProjects(lang, true);
// Le chemin du CV est accepté avec ou sans « / » initial ; il doit exister dans public/.
const cvPath = "/" + c.site.cv.replace(/^\/+/, "");
const hasCv = existsSync(join(process.cwd(), "public", cvPath));
// Dépose ta photo dans src/assets/ramzi.jpg (ou .png, .webp) : elle s’affiche automatiquement.
const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/ramzi.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(photos)[0]?.default;
const links = [
  { label: "GitHub", href: c.site.github, icon: "github" as const },
  { label: "LinkedIn", href: c.site.linkedin, icon: "linkedin" as const },
].filter((l) => l.href);
const pipelineHref = routes[lang].project("devsecops-pipeline");
---

<Base lang={lang} alt={lang === "fr" ? routes.en.home : routes.fr.home} description={c.site.description}>
  <Hero
    name={c.site.name}
    role={c.hero.role}
    bio={c.hero.bio}
    availability={c.hero.availability}
    monogram={c.hero.monogram}
    photo={photo}
    portraitAlt={t.home.portraitAlt(c.site.name)}
    badges={extras.badges}
    actions={{ contact: t.home.contactMe, projects: t.home.viewProjects, cv: t.home.downloadCv }}
    projectsHref={routes[lang].projects}
    email={c.site.email}
    cvHref={hasCv ? cvPath : undefined}
    links={links}
  />
  <TechBar label={extras.techLabel} />

  <section class="container gates-band" aria-labelledby="gates-title">
    <h2 id="gates-title">{c.site.headline}</h2>
    <ol class="gates">
      {c.gates.map((g, i) => (
        <li class="gate">
          <span class="gate-n">{i + 1}</span>
          <span><strong>{g.tool}</strong><span class="gate-stops">{t.blocks} {g.stops}.</span></span>
        </li>
      ))}
    </ol>
    <p class="gates-link"><a href={pipelineHref}>{t.home.readCase}</a></p>
  </section>

  <section class="section container split" id="projets">
    <h2>{t.home.projects}</h2>
    <div>
      <ul class="rows">{featured.map((p) => <ProjectRow entry={p.entry} slug={p.slug} lang={lang} fallback={p.fallback} />)}</ul>
      <p class="more"><a href={routes[lang].projects}>{t.home.allProjects}</a></p>
    </div>
  </section>

  <section class="section container split" id="competences">
    <h2>{t.home.skills}</h2>
    <dl class="skills">
      {c.skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.map((i) => <span class="tag">{i}</span>)}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section container split" id="parcours">
    <h2>{t.home.background}</h2>
    <ol class="timeline">
      {c.timeline.map((item) => (
        <li>
          <span class="period">{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p class="org">{item.org}</p>
            <p>{item.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {c.certifications.length > 0 && (
    <section class="section container split" id="certifications">
      <h2>{t.home.certifications}</h2>
      <ul class="certs">
        {c.certifications.map((cert) => (
          <li>
            {cert.url ? <a href={cert.url}>{cert.name}</a> : cert.name}
            <span class="org">{[cert.issuer, cert.year].filter(Boolean).join(", ")}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section container split" id="contact">
    <h2>{t.home.contact}</h2>
    <div>
      <p class="lead">{t.home.contactLead}</p>
      <p><a class="mail" href={`mailto:${c.site.email}`}>{c.site.email}</a></p>
      {links.length > 0 && (
        <ul class="inline-links">
          {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
        </ul>
      )}
    </div>
  </section>
</Base>
