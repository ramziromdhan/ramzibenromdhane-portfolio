---
import { getCollection } from "astro:content";
import ProjectPage from "../../components/ProjectPage.astro";
import { slugOf, langOf } from "../../i18n/projects";

export async function getStaticPaths() {
  const all = await getCollection("projects", ({ data }) => !data.draft);
  const other = new Set(all.filter((p) => langOf(p) !== "fr").map(slugOf));
  return all
    .filter((p) => langOf(p) === "fr")
    .map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry, hasOther: other.has(slugOf(entry)) } }));
}
const { entry, hasOther } = Astro.props;
---

<ProjectPage lang="fr" entry={entry} slug={Astro.params.slug} hasOther={hasOther} />
