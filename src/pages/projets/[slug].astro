---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, year, status, role, tags, repo, demo } = project.data;
---

<Base title={title} description={summary} type="article">
  <article class="container project">
    <p class="back"><a href="/projets">Tous les projets</a></p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <dl class="meta">
      <div><dt>Année</dt><dd>{year}</dd></div>
      <div><dt>Statut</dt><dd>{status}</dd></div>
      {role && <div><dt>Rôle</dt><dd>{role}</dd></div>}
      {repo && <div><dt>Code</dt><dd><a href={repo}>Dépôt GitHub</a></dd></div>}
      {demo && <div><dt>Démo</dt><dd><a href={demo}>Voir la démo</a></dd></div>}
    </dl>
    <p class="row-tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>
