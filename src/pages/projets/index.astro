---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { otherProjects } from "../../data/site";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Projets" description="Études de cas DevSecOps, détection et sécurité réseau : contexte, architecture, décisions et résultats.">
  <section class="container page-head">
    <h1>Projets</h1>
    <p class="lead">Les études de cas suivent le même plan : contexte, architecture, décisions de sécurité, résultats et leçons apprises.</p>
  </section>
  <section class="container section">
    <ul class="rows">{projects.map((p) => <ProjectRow project={p} />)}</ul>
  </section>
  {otherProjects.length > 0 && (
    <section class="container section split">
      <h2>Autres projets</h2>
      <ul class="others">
        {otherProjects.map((o) => (
          <li>
            <strong>{o.url ? <a href={o.url}>{o.title}</a> : o.title}</strong>
            <span class="row-summary">{o.text}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
