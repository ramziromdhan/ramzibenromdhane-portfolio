---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { site, gates, skills, timeline, certifications } from "../data/site";
import { hero } from "../data/hero";

const featured = (await getCollection("projects", ({ data }) => data.featured && !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const photos = import.meta.glob<{ default: ImageMetadata }>("../assets/ramzi.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(photos)[0]?.default;
const hasCv = existsSync(join(process.cwd(), "public", site.cv));
const links = [
  { label: "GitHub", href: site.github },
  { label: "LinkedIn", href: site.linkedin },
].filter((l) => l.href);
---

<Base>
  <section class="hero container">
    <div class="portrait-wrap">
      {photo ? (
        <Image class="portrait" src={photo} alt={`Portrait de ${site.name}`} width={480} height={480} loading="eager" fetchpriority="high" />
      ) : (
        <div class="monogram" aria-hidden="true">{hero.monogram}</div>
      )}
    </div>
    <div class="identity">
      {hero.availability && <p class="status"><span class="dot" aria-hidden="true"></span>{hero.availability}</p>}
      <h1>{site.name}</h1>
      <p class="role">{hero.role}</p>
      <p class="bio">{hero.bio}</p>
      <p class="actions">
        <a class="btn btn-primary" href="/projets">Voir les projets</a>
        <a class="btn" href={`mailto:${site.email}`}>Me contacter</a>
        {hasCv && <a class="btn" href={site.cv} download>Télécharger le CV</a>}
      </p>
      {links.length > 0 && (
        <ul class="inline-links">
          {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
        </ul>
      )}
    </div>
  </section>

  <section class="container gates-band" aria-labelledby="gates-title">
    <h2 id="gates-title">{site.headline}</h2>
    <ol class="gates">
      {gates.map((g, i) => (
        <li class="gate">
          <span class="gate-n">{i + 1}</span>
          <span><strong>{g.tool}</strong><span class="gate-stops">Bloque {g.stops}.</span></span>
        </li>
      ))}
    </ol>
    <p class="gates-link"><a href="/projets/devsecops-pipeline">Lire l’étude de cas du pipeline</a></p>
  </section>

  <section class="section container split" id="projets">
    <h2>Projets</h2>
    <div>
      <ul class="rows">{featured.map((p) => <ProjectRow project={p} />)}</ul>
      <p class="more"><a href="/projets">Tous les projets</a></p>
    </div>
  </section>

  <section class="section container split" id="competences">
    <h2>Compétences</h2>
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.map((i) => <span class="tag">{i}</span>)}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section container split" id="parcours">
    <h2>Parcours</h2>
    <ol class="timeline">
      {timeline.map((t) => (
        <li>
          <span class="period">{t.period}</span>
          <div>
            <h3>{t.title}</h3>
            <p class="org">{t.org}</p>
            <p>{t.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {certifications.length > 0 && (
    <section class="section container split" id="certifications">
      <h2>Certifications</h2>
      <ul class="certs">
        {certifications.map((c) => (
          <li>
            {c.url ? <a href={c.url}>{c.name}</a> : c.name}
            <span class="org">{[c.issuer, c.year].filter(Boolean).join(", ")}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section container split" id="contact">
    <h2>Contact</h2>
    <div>
      <p class="lead">Un projet, une mission ou un stage de fin d’études à discuter ? Écris-moi.</p>
      <p><a class="mail" href={`mailto:${site.email}`}>{site.email}</a></p>
      {links.length > 0 && (
        <ul class="inline-links">
          {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
        </ul>
      )}
    </div>
  </section>
</Base>
